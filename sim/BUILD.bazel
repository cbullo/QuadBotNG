load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_python//python:py_test.bzl", "py_test")
load("@sim_deps//:requirements.bzl", "requirement")

package(default_visibility = ["//visibility:public"])

alias(
    name = "inspector",
    actual = "//dashboard:inspector",
)

alias(
    name = "native_inspector",
    actual = "//dashboard:native",
)

py_library(
    name = "controller_viewer_lib",
    srcs = ["controller_viewer.py"],
    deps = [
        ":robot_model",
        "@rules_python//python/runfiles",
    ],
)

# Python wheels are for the development PC, not AVR or the Odroid sysroot.
PC_CONSTRAINTS = [
    "@platforms//cpu:x86_64",
    "@platforms//os:linux",
]

py_library(
    name = "robot_model",
    srcs = ["robot_model.py"],
    data = [
        "collision_geometry.json",
        "robot_parameters.json",
        "urdf/quadbot.urdf",
        "//src/odroid_controller/controller:config/robot_config.yaml",
    ] + glob(["meshes/*.stl"]),
    target_compatible_with = PC_CONSTRAINTS,
    deps = [
        requirement("mujoco"),
        requirement("numpy"),
        requirement("pyyaml"),
    ],
)

py_binary(
    name = "generate_model",
    srcs = ["robot_model.py"],
    main = "robot_model.py",
    target_compatible_with = PC_CONSTRAINTS,
    deps = [":robot_model"],
)

py_library(
    name = "imu",
    srcs = ["imu.py"],
    deps = [requirement("numpy")],
)

py_test(
    name = "imu_test",
    size = "small",
    srcs = ["imu_test.py"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [
        ":imu",
        ":robot_model",
    ],
)

py_library(
    name = "gym_env",
    srcs = [
        "goals.py",
        "gym_env.py",
        "gym_motor.py",
    ],
    data = ["motor_model.yaml"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [
        ":controller_viewer_lib",
        ":imu",
        ":robot_model",
        requirement("gymnasium"),
        requirement("numpy"),
        requirement("pyyaml"),
    ],
)

py_binary(
    name = "gym_rollout",
    srcs = ["gym_rollout.py"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [
        ":gym_env",
        requirement("pillow"),
    ],
)

py_test(
    name = "gym_env_test",
    size = "medium",
    srcs = ["gym_env_test.py"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [":gym_env"],
)

py_library(
    name = "training",
    srcs = ["gpu_walk.py", "policy_initialization.py", "training.py", "training_compute.py"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [
        ":gym_env",
        requirement("stable-baselines3"),
        requirement("torch"),
        requirement("mujoco-warp"),
        requirement("warp-lang"),
    ],
)

py_library(
    name = "training_view",
    srcs = ["training_view.py"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [
        ":training",
        "@rules_python//python/runfiles",
        requirement("pyside6_essentials"),
        requirement("pyqtgraph"),
    ],
)

py_binary(
    name = "train",
    srcs = ["train.py"],
    data = [":train_worker"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [":training_view"],
)

py_binary(
    name = "train_worker",
    srcs = ["train.py"],
    main = "train.py",
    target_compatible_with = PC_CONSTRAINTS,
    deps = [":training"],
)

py_binary(
    name = "evaluate_policy",
    srcs = ["evaluate_policy.py"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [":training"],
)

py_library(
    name = "walk_training",
    srcs = ["droq.py", "walk_env.py", "walk_training.py"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [":training", requirement("sb3-contrib")],
)

py_test(
    name = "droq_test",
    size = "small",
    srcs = ["droq_test.py"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [":walk_training"],
)

py_test(
    name = "gpu_walk_test",
    size = "large",
    srcs = ["gpu_walk_test.py"],
    tags = ["manual", "local", "requires-gpu"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [":walk_training"],
)

py_binary(
    name = "walk_train",
    srcs = ["walk_train.py"],
    data = [":walk_train_worker"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [":walk_training_view"],
)

py_binary(
    name = "walk_train_worker",
    srcs = ["walk_train.py"],
    main = "walk_train.py",
    target_compatible_with = PC_CONSTRAINTS,
    deps = [":walk_training"],
)

py_library(
    name = "walk_training_view",
    srcs = ["walk_training_view.py"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [":walk_training", ":training_view"],
)

py_test(
    name = "walk_training_view_test",
    size = "medium",
    srcs = ["walk_training_view_test.py"],
    data = [":walk_train"],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    target_compatible_with = PC_CONSTRAINTS,
    deps = [":walk_training_view"],
)

py_binary(
    name = "walk_evaluate",
    srcs = ["walk_evaluate.py"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [":walk_training"],
)

py_test(
    name = "walk_test",
    size = "medium",
    srcs = ["walk_test.py"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [":walk_training"],
)

py_test(
    name = "training_test",
    size = "medium",
    srcs = ["training_test.py"],
    data = [":train"],
    env = {"QT_QPA_PLATFORM": "offscreen"},
    target_compatible_with = PC_CONSTRAINTS,
    deps = [":training_view"],
)

py_test(
    name = "robot_model_test",
    size = "small",
    srcs = ["robot_model_test.py"],
    data = [
        "mujoco/quadbot.xml",
        "mujoco/quadbot_suspended.xml",
        "//src/odroid_controller/controller:config/robot_config.yaml",
    ],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [":robot_model"],
)

py_binary(
    name = "robot_demo",
    srcs = ["robot_demo.py"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [
        ":robot_model",
        requirement("pillow"),
    ],
)

py_binary(
    name = "viewer",
    srcs = ["viewer.py"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [requirement("mujoco")],
)

py_test(
    name = "smoke_test",
    size = "small",
    srcs = ["smoke_test.py"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [
        requirement("gymnasium"),
        requirement("mujoco"),
        requirement("numpy"),
    ],
)

cc_library(
    name = "native_runner",
    srcs = ["native/runner.cc"],
    data = [
        "motor_model.yaml",
        "mujoco/quadbot.xml",
        "mujoco/quadbot_suspended.xml",
        "//src/odroid_controller/controller:config/robot_config.yaml",
    ] + glob(["meshes/*.stl"]),
    target_compatible_with = PC_CONSTRAINTS,
    deps = [
        ":motor_plant",
        "//src/odroid_controller:controller_lib",
        "//src/odroid_controller:emulated_board",
        "@sim_deps_312_mujoco//:native",
    ],
)

cc_test(
    name = "motor_plant_test",
    size = "small",
    srcs = ["native/motor_plant_test.cc"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [
        ":motor_plant",
        "@com_google_googletest//:gtest_main",
    ],
)

py_test(
    name = "native_runner_test",
    size = "medium",
    srcs = ["native_runner_test.py"],
    data = ["//src/odroid_controller/controller"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [requirement("numpy")],
)

cc_library(
    name = "motor_plant",
    hdrs = ["native/motor_plant.h"],
)

py_binary(
    name = "controller_viewer",
    srcs = ["controller_viewer.py"],
    data = ["//src/odroid_controller/controller"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [
        "@rules_python//python/runfiles",
        requirement("mujoco"),
        requirement("numpy"),
    ],
)

py_test(
    name = "controller_viewer_test",
    size = "small",
    srcs = [
        "controller_viewer.py",
        "controller_viewer_test.py",
    ],
    main = "controller_viewer_test.py",
    target_compatible_with = PC_CONSTRAINTS,
    deps = [
        "@rules_python//python/runfiles",
        requirement("mujoco"),
        requirement("numpy"),
    ],
)

py_binary(
    name = "benchmark_training",
    srcs = ["benchmark_training.py"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [":walk_training"],
)

py_test(
    name = "training_compute_test",
    size = "medium",
    srcs = ["training_compute_test.py"],
    target_compatible_with = PC_CONSTRAINTS,
    deps = [":walk_training"],
)
